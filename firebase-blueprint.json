{
  "entities": {
    "CartItem": {
      "title": "CartItem",
      "description": "An item in an order",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["set", "addon"] },
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "number", "minimum": 0 },
        "qty": { "type": "number", "minimum": 1 }
      },
      "required": ["type", "name", "price", "qty"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "deliveryMethod": { "type": "string", "maxLength": 50 },
        "deliveryDate": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "referrer": { "type": "string", "maxLength": 100 },
        "bankLast5": { "type": "string", "maxLength": 5 },
        "note": { "type": "string", "maxLength": 500 },
        "items": { "type": "array", "items": { "$ref": "#/entities/CartItem" }, "maxLength": 50 },
        "subtotal": { "type": "number", "minimum": 0 },
        "shipping": { "type": "number", "minimum": 0 },
        "totalAmount": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": [
        "createdAt", "customerName", "phone", "deliveryMethod",
        "items", "subtotal", "shipping", "totalAmount", "status"
      ]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores all customer orders"
    }
  }
}
